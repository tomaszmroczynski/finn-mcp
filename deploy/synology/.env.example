# Skopiuj jako .env NA SYNOLOGY (/volume1/docker/finn-mcp/.env), wypelnij i zabezpiecz:
#   chmod 600 .env
# Tego pliku z wartosciami NIE commituj i nie wklejaj do rozmow.

# Token dostepowy (openssl rand -hex 32). Trzymaj rowniez w menedzerze hasel.
FINN_MCP_ACCESS_TOKEN=

# Domena, pod ktora serwer jest wystawiony przez reverse proxy DSM.
# Trafia do allowed_hosts przy budowaniu obrazu; bez niej kazde zadanie zza
# proxy dostaje 421 Invalid Host header.
FINN_MCP_ALLOWED_HOST=

# Port na loopbacku NAS-a (domyslnie 8000).
FINN_MCP_PORT=8000

# Limit zapytan do FINN.no na minute (domyslnie 20).
FINN_REQUESTS_PER_MINUTE=20

# --- OAuth dla custom connectorow (claude.ai) — opcjonalne -------------------
# Publiczny adres serwera BEZ /mcp. Ustawienie wlacza serwer autoryzacyjny
# (/authorize, /token, /register, /.well-known/...). Puste = tylko token statyczny.
FINN_MCP_PUBLIC_URL=

# To, co wpisujesz w przegladarce na stronie /login przy dodawaniu connectora
# (openssl rand -base64 24). Osobne od tokenu dostepowego, zeby tokenu maszyn
# nie wpisywac do przegladarki. Puste = uzywany jest FINN_MCP_ACCESS_TOKEN.
FINN_MCP_LOGIN_SECRET=
